# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，不会进仓库。

# ── 扶摇（同花顺金融数据服务）API Key —— 必填 ──────────────────────
# 申请地址：https://fuyao.aicubes.cn/admin/
HITHINK_FINANCE_API_KEY=replace-me


# ── 推断层（可选）──────────────────────────────────────────────
# 不填也能完整运行：事实 / 未知 / 矛盾三类证据全部由确定性代码产出，
# 不依赖模型；只是不会有「推断」类证据，页面会如实标注「推断层未启用」。
#
# 填好后先跑一次自检：  python llm.py
# 再启动：              python app.py

# 方案 A｜智谱 GLM —— 推荐：4.x 代 Flash 长期 0 元，免绑卡
# 申请：https://bigmodel.cn/usercenter/apikeys
# ⚠️ 模型名必须用 glm-4-flash-250414。
#    实测 glm-4.7-flash 是推理模型，回复两个字要 57 秒，本场景不可用；
#    glm-4-flash-250414 同样的请求只要 0.4 秒。
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash-250414

# 方案 B｜DeepSeek —— 极便宜（不是免费）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 方案 C｜通义千问 —— 每模型 100 万 tokens，90 天有效
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-turbo

# 方案 D｜硅基流动 —— 部分模型 0 元 + 注册送券
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen3-8B

LLM_API_KEY=
